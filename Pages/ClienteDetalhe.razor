@page "/clientes/{CustomerId}"
@inject IStockDataProvider DataProvider

<a class="back-link" href="/clientes">← Voltar para clientes</a>

@if (_cliente is null)
{
    <p>Cliente não encontrado.</p>
}
else
{
    <h2 class="section-title" style="margin-top:0">@_cliente.CompanyName</h2>

    <div class="card">
        <div class="info-grid">
            <div class="info-item">
                <div class="label">CNPJ</div>
                <div class="value">@_cliente.TaxId</div>
            </div>
            <div class="info-item">
                <div class="label">Cidade / UF</div>
                <div class="value">@_cliente.City / @_cliente.State</div>
            </div>
            <div class="info-item">
                <div class="label">Contato</div>
                <div class="value">@_cliente.ContactName</div>
            </div>
            <div class="info-item">
                <div class="label">E-mail</div>
                <div class="value">@_cliente.ContactEmail</div>
            </div>
            <div class="info-item">
                <div class="label">Telefone</div>
                <div class="value">@_cliente.ContactPhone</div>
            </div>
        </div>
    </div>

    <div class="section-title">Assinaturas</div>

    @if (!_subscriptions.Any())
    {
        <p style="color: var(--advanced-gray)">Nenhuma assinatura encontrada para este cliente.</p>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Assinatura</th>
                    <th>Tipo</th>
                    <th>Contrato</th>
                    <th>Status</th>
                    <th>Qtd.</th>
                    <th>Vencimento</th>
                    <th>Valor</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in _subscriptions)
                {
                    <tr>
                        <td>@s.SubscriptionName</td>
                        <td>@s.OfferType</td>
                        <td title="@ContractLabel.Long(s.OfferType, s.TermDuration, s.BillingFrequency)">@ContractLabel.Short(s.OfferType, s.TermDuration, s.BillingFrequency)</td>
                        <td>
                            <span class="badge @StatusBadgeClass(s.Status)">@s.Status</span>
                            @if (s.IsRenewalSoon)
                            {
                                <span class="badge badge-renewal" style="margin-left:6px;">vence em @s.DaysUntilRenewal dias</span>
                            }
                        </td>
                        <td>@s.Quantity @(s.AssignedLicenses is not null ? $"({s.AssignedLicenses} em uso)" : "")</td>
                        <td>@(s.EndDate.Year < 9000 ? s.EndDate.ToString("dd/MM/yyyy") : "sem vencimento")</td>
                        <td>
                            @if (string.Equals(s.OfferType, "azureplan", StringComparison.OrdinalIgnoreCase))
                            {
                                <span>Usage-based</span>
                            }
                            else
                            {
                                <span>@s.RevenuePrice.Value.ToString("C", _ptBr) / @TraduzFrequencia(s.BillingFrequency)</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <p style="color: var(--advanced-gray); font-size: 0.85rem; margin-top: 12px;">
            Contrato = prazo/cobrança. Ex.: Anual/Mensal é um contrato de 1 ano cobrado mensalmente.
        </p>
    }
}

@code {
    [Parameter] public string CustomerId { get; set; } = "";

    private CustomerDto? _cliente;
    private List<SubscriptionDto> _subscriptions = new();
    private readonly System.Globalization.CultureInfo _ptBr = new("pt-BR");

    protected override async Task OnInitializedAsync()
    {
        var clientes = await DataProvider.GetCustomersAsync();
        _cliente = clientes.FirstOrDefault(c => c.Id == CustomerId);
        _subscriptions = await DataProvider.GetSubscriptionsByCustomerAsync(CustomerId);
    }

    private static string StatusBadgeClass(string status) => status switch
    {
        "active" => "badge-active",
        "deleted" => "badge-deleted",
        "suspended" => "badge-suspended",
        _ => "badge-deleted"
    };

    private static string TraduzFrequencia(string freq) => freq switch
    {
        "monthly" => "mês",
        "annual" => "ano",
        "onetime" => "pagamento único",
        _ => freq
    };
}
